{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "registration_number": {
      "type": "string",
      "description": "Registration number"
    },
    "bride_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Bride's name"
    },
    "groom_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Groom's name"
    },
    "date_of_marriage": {
      "type": "string",
      "pattern": "^((0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4}|[0-9]{4})$",
      "description": "Date of marriage in DD/MM/YYYY or YYYY format"
    },
    "place_of_marriage": {
      "type": "string",
      "description": "Place of marriage"
    }
  },
  "required": ["registration_number", "bride_name", "groom_name", "date_of_marriage"],
  "additionalProperties": false
}
