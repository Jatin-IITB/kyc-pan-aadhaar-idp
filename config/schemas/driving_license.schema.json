{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "dl_number": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{2}\\s?[0-9]{11}$",
      "description": "Indian driving license number"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Full name as on driving license"
    },
    "date_of_birth": {
      "type": "string",
      "pattern": "^((0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4}|[0-9]{4})$",
      "description": "Date of birth in DD/MM/YYYY or YYYY format"
    },
    "blood_group": {
      "type": "string",
      "description": "Blood group"
    },
    "address": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Full address"
    },
    "date_of_issue": {
      "type": "string",
      "pattern": "^((0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4}|[0-9]{4})$",
      "description": "Date of issue in DD/MM/YYYY or YYYY format"
    },
    "date_of_expiry": {
      "type": "string",
      "pattern": "^((0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4}|[0-9]{4})$",
      "description": "Date of expiry in DD/MM/YYYY or YYYY format"
    }
  },
  "required": ["dl_number", "name", "date_of_birth"],
  "additionalProperties": false
}
