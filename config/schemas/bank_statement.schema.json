{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "account_number": {
      "type": "string",
      "description": "Bank account number"
    },
    "account_holder": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Account holder name"
    },
    "bank_name": {
      "type": "string",
      "description": "Bank name"
    },
    "ifsc_code": {
      "type": "string",
      "pattern": "^[A-Z]{4}0[A-Z0-9]{6}$",
      "description": "11-character IFSC code"
    },
    "branch": {
      "type": "string",
      "description": "Branch name"
    },
    "statement_period": {
      "type": "string",
      "description": "Statement period"
    },
    "address": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Full address"
    }
  },
  "required": ["account_holder", "bank_name", "statement_period"],
  "additionalProperties": false
}
