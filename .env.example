# Redis (message broker & result backend)
REDIS_URL=redis://127.0.0.1:6379/0

# PostgreSQL (case & audit persistence)
DATABASE_URL=postgresql+asyncpg://kyc:kyc@localhost:5432/kyc_idp

# MinIO (document object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kyc-documents

# Qdrant (vector store for RAG policy engine)
QDRANT_URL=http://localhost:6333

# Ollama LLM (for OCR noise cleanup rescue)
KYC_OLLAMA_URL=http://localhost:11434
KYC_OLLAMA_MODEL=qwen3:8b
KYC_OLLAMA_TIMEOUT_S=20

# Ollama VLM (for vision-based extraction fallback)
KYC_VLM_MODEL=llama3.2-vision:11b
KYC_VLM_TIMEOUT_S=30

# API Authentication (comma-separated keys; empty = no auth)
KYC_API_KEYS=

# CORS Allowed Origins (comma-separated; defaults to localhost)
KYC_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Application config
KYC_CONFIG_PATH=config/app.yaml

# Celery
CELERY_RESULT_EXPIRES_S=86400

# Worker performance
OMP_NUM_THREADS=2

# Active Learning
KYC_GROUND_TRUTH_PATH=data/ground_truth
KYC_RETRAIN_CORRECTION_THRESHOLD=100
KYC_RETRAIN_F1_DROP_THRESHOLD=0.02
