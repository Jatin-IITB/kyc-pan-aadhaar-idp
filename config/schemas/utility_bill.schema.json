{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "account_number": {
      "type": "string",
      "description": "Utility account number"
    },
    "customer_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Customer name"
    },
    "service_type": {
      "type": "string",
      "enum": ["Electricity", "Water", "Gas", "Telephone", "Internet"],
      "description": "Type of utility service"
    },
    "billing_address": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Billing address"
    },
    "bill_date": {
      "type": "string",
      "pattern": "^((0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4}|[0-9]{4})$",
      "description": "Bill date in DD/MM/YYYY or YYYY format"
    },
    "due_date": {
      "type": "string",
      "pattern": "^((0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4}|[0-9]{4})$",
      "description": "Due date in DD/MM/YYYY or YYYY format"
    },
    "amount_due": {
      "type": "string",
      "description": "Amount due"
    }
  },
  "required": ["customer_name", "billing_address", "bill_date"],
  "additionalProperties": false
}
