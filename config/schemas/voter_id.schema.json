{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "epic_number": {
      "type": "string",
      "pattern": "^[A-Z]{3}[0-9]{7}$",
      "description": "10-character EPIC number"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Full name as on voter ID"
    },
    "father_name": {
      "type": "string",
      "description": "Father's name"
    },
    "date_of_birth": {
      "type": "string",
      "pattern": "^((0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4}|[0-9]{4})$",
      "description": "Date of birth in DD/MM/YYYY or YYYY format"
    },
    "gender": {
      "type": "string",
      "enum": ["Male", "Female", "Other"],
      "description": "Gender"
    },
    "address": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Full address"
    }
  },
  "required": ["epic_number", "name"],
  "additionalProperties": false
}
